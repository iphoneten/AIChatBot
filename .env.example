# ===== Telegram（bot-api 使用）=====
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY=                        # 访问 api.telegram.org 的代理，如 http://127.0.0.1:7897，留空直连

# ===== LLM（经 RouterHub 中转，OpenAI 兼容协议）=====
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ===== 对话参数 =====
SYSTEM_PROMPT=你是一个乐于助人的中文AI助手
MAX_CONTEXT_MESSAGES=20
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
DEFAULT_DAILY_LIMIT=0                   # 全局默认每日提问上限（0=不限）

# ===== 服务地址（bot-api / admin-web 调用 agent 用）=====
AGENT_BASE_URL=http://127.0.0.1:8100
AGENT_LISTEN_ADDR=0.0.0.0:8100
ADMIN_LISTEN_ADDR=0.0.0.0:8200
AGENT_INTERNAL_TOKEN=

# ===== 数据库（agent 持有）=====
DB_PATH=data/bot.db

# ===== 管理后台 =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
